# Variáveis do serviço crm-2026 no Railway → Variables
#
# O CRM roda no Railway com o banco no Supabase (Postgres gerenciado).

# --- Banco de dados -------------------------------------------------------
# Connection string do Supabase. Pegue em: Supabase → Project Settings →
# Database → Connection string → URI, e prefira o modo "Session pooler"
# (porta 6543): o app abre e fecha conexão a cada operação, e o pooler evita
# esgotar o limite de conexões do Postgres.
#
# Definir esta variável é o que faz o app usar Postgres. Sem ela, ele cai no
# SQLite local — que no contêiner do Railway some a cada deploy, a menos que
# haja um volume montado.
DATABASE_URL=postgresql://postgres.SEU-REF:SUA-SENHA@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# --- Segredos -------------------------------------------------------------
# Assinatura dos tokens de acesso. Se ficar vazia, o app gera uma e grava em
# arquivo no diretório de dados — o que, num contêiner sem volume, muda a cada
# deploy e invalida todas as sessões.
CRM_API_JWT_SECRET=gere-uma-chave-aleatoria-com-32-caracteres-ou-mais

# Validação HMAC do webhook do WhatsApp. O provedor precisa assinar com o
# mesmo valor, senão as mensagens são recusadas com 401.
CRM_WHATSAPP_HMAC_SECRET=mesmo-segredo-configurado-no-provedor

# Token de verificação exigido pelo provedor no GET inicial do webhook.
CRM_WHATSAPP_VERIFY_TOKEN=token-combinado-com-o-provedor

# --- Aplicação ------------------------------------------------------------
CRM_PUBLIC_URL=https://crm.trustcorp.com.br

# Assistente de IA (opcional). Sem a chave, o painel de chat não aparece.
DEEPSEEK_API_KEY=sua-chave-deepseek-aqui
DEEPSEEK_MODEL=deepseek-chat

# --- Senhas iniciais ------------------------------------------------------
# ATENÇÃO: só têm efeito quando a tabela de usuários está VAZIA — ou seja, no
# primeiro arranque de um banco novo. Com o Supabase, isso acontece uma única
# vez. Depois disso, use Administração → «Contas de acesso» para criar contas
# e redefinir senhas.
#
# Se nenhuma for definida, cada conta nasce com senha aleatória, registrada
# uma única vez no log de inicialização do Railway.
# CRM_SEED_PASSWORD_ADMIN=escolha-uma-senha-forte

# --- Não use mais ---------------------------------------------------------
# CRM_LOCAL_MODE e CRM_DATA_DIR só fazem sentido no modo SQLite com volume.
# Com DATABASE_URL apontando para o Supabase, são ignorados.
